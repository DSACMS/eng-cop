{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "config.yml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repo",
    "timezone",
    "cadence",
    "ospoEmail",
    "roundRobinMinutes",
    "formats",
    "layouts"
  ],
  "properties": {
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "cadence": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "ospoEmail": {
      "type": "string",
      "pattern": "^([^@\\s]+@[^@\\s]+\\.[^@\\s]+)?$"
    },
    "roundRobinMinutes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 30
    },
    "formats": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "minutes"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "minutes": {
            "type": "integer",
            "minimum": 5,
            "maximum": 60
          }
        }
      }
    },
    "layouts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      }
    }
  }
}
