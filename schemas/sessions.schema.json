{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sessions.yml",
  "type": "object",
  "additionalProperties": false,
  "required": ["sessions"],
  "properties": {
    "sessions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date"],
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "layout": { "type": "string", "minLength": 1 },
          "cancelled": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    }
  }
}
